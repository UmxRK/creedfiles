. "$CREED_TWEAK_DIR/../../lib.sh"
put /etc/systemd/resolved.conf.d/creed-dot.conf <<'X'
# Creed: encrypted DNS
[Resolve]
DNS=1.1.1.1#cloudflare-dns.com 9.9.9.9#dns.quad9.net 2606:4700:4700::1111#cloudflare-dns.com
FallbackDNS=1.0.0.1#cloudflare-dns.com 149.112.112.112#dns.quad9.net
DNSOverTLS=opportunistic
X
run systemctl restart systemd-resolved
if live && ! readlink /etc/resolv.conf | grep -q resolve; then
  echo "Note: /etc/resolv.conf does not point at systemd-resolved, so this has no effect until it does."
fi
