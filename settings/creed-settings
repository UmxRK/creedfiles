class ModesPage(Gtk.ScrolledWindow):
    def __init__(self, win):
        super().__init__(vexpand=True)
        self.win = win
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, margin_top=24, margin_bottom=24, margin_start=24, margin_end=24)
        title = Gtk.Label(label="Pick a look", xalign=0, css_classes=["title-1"])
        sub = Gtk.Label(label="Each mode changes the whole desktop: bar, dock, menus, window style, keyboard shortcuts, lock screen and app colours. You can switch back at any time.", xalign=0, wrap=True, css_classes=["dim-label"])
        box.append(title)
        box.append(sub)
        self.flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=3, min_children_per_line=1, column_spacing=16, row_spacing=16, homogeneous=True)
        box.append(self.flow)
        self.set_child(box)
        self.populate()

    def populate(self):
        while (c := self.flow.get_first_child()) is not None:
            self.flow.remove(c)
        ok, out = creed("mode", "list")
        current = ""
        modes = []
        for line in out.splitlines():
            if not line.strip():
                continue
            marker, rest = line[:1], line[2:]
            parts = rest.split(None, 1)
            mid = parts[0]
            remainder = parts[1] if len(parts) > 1 else ""
            # name is padded to 16 chars in the CLI output
            name = remainder[:16].strip()
            desc = remainder[16:].strip()
            modes.append((mid, name, desc))
            if marker == "●":
                current = mid
        data_dir = os.environ.get("CREED_DATA") or _data_dir()
        for mid, name, desc in modes:
            self.flow.append(self.card(mid, name, desc, mid == current, data_dir))

    def card(self, mid, name, desc, active, data_dir):
        btn = Gtk.Button(css_classes=["card", "mode-card"] + (["mode-active"] if active else []))
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=10, margin_bottom=12, margin_start=10, margin_end=10)
        prev = os.path.join(data_dir, "modes", mid, "preview.png")
        if os.path.isfile(prev):
            pic = Gtk.Picture.new_for_filename(prev)
            pic.set_content_fit(Gtk.ContentFit.COVER)
            pic.set_size_request(280, 158)
            pic.add_css_class("mode-preview")
            v.append(pic)
        head = Gtk.Box(spacing=8)
        head.append(Gtk.Label(label=name, xalign=0, hexpand=True, css_classes=["heading"]))
        if active:
            head.append(Gtk.Label(label="Active", css_classes=["accent", "caption-heading"]))
        v.append(head)
        v.append(Gtk.Label(label=desc, xalign=0, wrap=True, max_width_chars=36, css_classes=["dim-label", "caption"]))
        btn.set_child(v)
        btn.update_property([Gtk.AccessibleProperty.LABEL], [f"{name} mode. {desc}"])
        btn.connect("clicked", lambda _b: self.choose(mid, name))
        return btn

    def choose(self, mid, name):
        self.win.toast(f"Switching to {name}…")

        def work():
            ok, out = creed("mode", "set", mid)
            GLib.idle_add(self.after, ok, out, name)

        threading.Thread(target=work, daemon=True).start()

    def after(self, ok, out, name):
        self.win.toast(f"{name} is on" if ok else out)
        self.win.store.reload()
        app = self.win.get_application()
        if app is not None and hasattr(app, "follow_scheme"):
            app.follow_scheme()
        self.populate()
        return False


def _data_dir():
    for d in (os.path.expanduser("~/.local/share/creed"), "/usr/share/creed"):
        if os.path.isdir(os.path.join(d, "modes")):
            return d
    return "/usr/share/creed"


def appearance_page(store, win):
    wp_options = [(v, l) for v, l in PROCEDURAL]
    cur = store.get("appearance.wallpaper", "")
    if cur and not cur.startswith("creed://"):
        wp_options.append((cur, os.path.basename(cur)))
    wp_row = combo_row(store, "appearance.wallpaper", "Wallpaper", wp_options, "Built-in wallpapers are drawn live at your screen's resolution")
    pick = Gtk.Button(label="Choose image…", valign=Gtk.Align.CENTER)

    def choose(_b):
        dlg = Gtk.FileDialog(title="Choose a wallpaper")
        f = Gtk.FileFilter()
        f.set_name("Images")
        for m in ("image/png", "image/jpeg", "image/webp"):
            f.add_mime_type(m)
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(f)
        dlg.set_filters(filters)

        def done(d, res):
            try:
                file = d.open_finish(res)
            except GLib.Error:
                return
            if file:
                store.set("appearance.wallpaper", file.get_path(), immediate=True)
                win.toast("Wallpaper set - colours follow it if “From wallpaper” is on")

        dlg.open(win, None, done)

    pick.connect("clicked", choose)
    wp_row.add_suffix(pick)
    return page(
        "Appearance", "applications-graphics-symbolic",
        group("Colours", "",
              combo_row(store, "appearance.color_source", "Colour source", [("wallpaper", "From wallpaper"), ("preset", "Preset palette")]),
              combo_row(store, "appearance.preset", "Preset", [(p, p.capitalize()) for p in PRESETS]),
              combo_row(store, "appearance.scheme", "Style", [("dark", "Dark"), ("light", "Light")]),
              wp_row),
        group("Motion", "Choose how lively the desktop feels. Lighter presets use less GPU.",
              combo_row(store, "appearance.motion", "Animations", [
                  ("expressive", "Expressive - springy, playful (most GPU)"),
                  ("smooth", "Smooth - quick eased transitions"),
                  ("minimal", "Minimal - short fades only"),
                  ("off", "Off - instant (least GPU)")])),
        group("Text", "",
              spin_row(store, "appearance.font_size", "Font size (pt)", 7, 20, 0.5, 1),
              slider_row(store, "appearance.text_scale", "Text scale", 0.8, 2.0, 0.05, fmt="{:.2f}×"),
              entry_row(store, "appearance.font", "Interface font")),
