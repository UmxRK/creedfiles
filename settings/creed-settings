class ModuleList(Adw.PreferencesGroup):
    """Editable ordered list of bar modules for one section."""

    def __init__(self, store, key, title):
        super().__init__(title=esc(title))
        self.store, self.key = store, key
        add = Gtk.MenuButton(icon_name="list-add-symbolic", tooltip_text="Add module", css_classes=["flat"])
        menu = Gio.Menu()
        for m in BAR_MODULES:
            menu.append(m, f"win.addmod::{key}|{m}")
        add.set_menu_model(menu)
        self.set_header_suffix(add)
        self.rows = []
        self.render()

    def render(self):
        for r in self.rows:
            self.remove(r)
        self.rows = []
        items = list(self.store.get(self.key, []) or [])
        if not items:
            r = Adw.ActionRow(title="Empty", subtitle="Use + to add modules", use_markup=False)
            self.add(r)
            self.rows.append(r)
        for i, m in enumerate(items):
            r = Adw.ActionRow(title=m, use_markup=False)
            for icon, tip, fn in (("go-up-symbolic", "Move up", lambda _b, i=i: self.move(i, -1)),
                                  ("go-down-symbolic", "Move down", lambda _b, i=i: self.move(i, 1)),
                                  ("user-trash-symbolic", "Remove", lambda _b, i=i: self.delete(i))):
                b = Gtk.Button(icon_name=icon, tooltip_text=tip, valign=Gtk.Align.CENTER, css_classes=["flat"])
                b.connect("clicked", fn)
                r.add_suffix(b)
            self.add(r)
            self.rows.append(r)

    def save(self, items):
        self.store.set(self.key, items, immediate=True)
        self.render()

    def move(self, i, d):
        items = list(self.store.get(self.key, []))
        j = i + d
        if 0 <= j < len(items):
            items[i], items[j] = items[j], items[i]
            self.save(items)

    def delete(self, i):
        items = list(self.store.get(self.key, []))
        del items[i]
        self.save(items)

    def append(self, m):
        items = list(self.store.get(self.key, []))
        items.append(m)
        self.save(items)


