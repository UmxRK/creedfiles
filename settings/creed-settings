class TweaksPage(Gtk.ScrolledWindow):
    CATS = [("gaming", "Gaming"), ("network", "Network & Wi-Fi"), ("system", "System & memory"), ("battery", "Battery & laptop"), ("cleanup", "Cleanup & free space")]

    def __init__(self, win):
        super().__init__(vexpand=True)
        self.win = win
        self.prefs = Adw.PreferencesPage()
        self.set_child(self.prefs)
        self.groups = []
        self.refresh()

    def refresh(self):
        for g in self.groups:
            self.prefs.remove(g)
        self.groups = []
        ok, out = creed("tweak", "list", "--json")
        try:
            tweaks = json.loads(out) if ok else []
        except json.JSONDecodeError:
            tweaks = []
        intro = Adw.PreferencesGroup(title="Tweaks", description=esc("Every tweak shows exactly what it changes before it runs. ★ marks what is recommended for this machine. System tweaks are reversible with one click; cleanups delete data and always ask."))
        self.prefs.add(intro)
        self.groups.append(intro)
        for cat, title in self.CATS:
            items = [t for t in tweaks if t["category"] == cat]
            if not items:
                continue
            g = Adw.PreferencesGroup(title=esc(title))
            for t in items:
                g.add(self.row(t))
            self.prefs.add(g)
            self.groups.append(g)

    def row(self, t):
        star = "★ " if t["recommended"] else ""
        status = {"applied": "Applied", "off": "", "n/a": "Not available on this machine"}[t["status"]]
        r = Adw.ActionRow(title=f"{star}{t['title']}", subtitle=status, use_markup=False)
        r.set_title_lines(1)
        b = Gtk.Button(label="Details", valign=Gtk.Align.CENTER, css_classes=["flat"])
        b.connect("clicked", lambda _b: self.details(t))
        r.add_suffix(b)
        if t["status"] == "applied" and not t["destructive"]:
            act = Gtk.Button(label="Revert", valign=Gtk.Align.CENTER)
            act.connect("clicked", lambda _b: self.run(["tweak", "revert", t["id"]], f"Reverted: {t['title']}"))
            r.add_suffix(act)
        elif t["status"] != "n/a":
            act = Gtk.Button(label="Run" if t["destructive"] else "Apply", valign=Gtk.Align.CENTER, css_classes=["destructive-action" if t["destructive"] else "suggested-action"])
            act.connect("clicked", lambda _b: self.details(t))
            r.add_suffix(act)
        return r

    def details(self, t):
        ok, text = creed("tweak", "explain", t["id"])
        dlg = Adw.AlertDialog(heading=t["title"], body=text if ok else t["explain"])
        dlg.set_body_use_markup(False)
        dlg.add_response("cancel", "Close")
        if t["status"] == "applied" and not t["destructive"]:
            dlg.add_response("revert", "Revert")
        elif t["status"] != "n/a":
            dlg.add_response("apply", "Delete now" if t["destructive"] else "Apply")
            dlg.set_response_appearance("apply", Adw.ResponseAppearance.DESTRUCTIVE if t["destructive"] else Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("cancel")
        dlg.set_close_response("cancel")

        def resp(_d, r):
            if r == "apply":
                args = ["tweak", "apply", t["id"], "--yes"] + (["--confirm"] if t["destructive"] else [])
                self.run(args, f"Done: {t['title']}" + (" - reboot to finish" if t["needs_reboot"] else ""))
            elif r == "revert":
                self.run(["tweak", "revert", t["id"]], f"Reverted: {t['title']}")

        dlg.connect("response", resp)
        dlg.present(self.win)

    def run(self, args, msg):
        def work():
            ok, out = creed(*args)
            GLib.idle_add(self.after, ok, out, msg)

        threading.Thread(target=work, daemon=True).start()

    def after(self, ok, out, msg):
        self.win.toast(msg if ok else out.splitlines()[-1] if out else "Failed")
        self.refresh()
        return False


