class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.page = None
        self.welcome = False

    def do_command_line(self, cmd):
        args = cmd.get_arguments()[1:]
        if "--welcome" in args:
            self.welcome = True
        if "--page" in args and args.index("--page") + 1 < len(args):
            self.page = args[args.index("--page") + 1]
        self.activate()
        return 0

    def follow_scheme(self):
        """Light/dark like the active mode, without relying on the settings portal."""
        ok, out = creed("config", "dump")
        scheme, family = "auto", "creed"
        if ok:
            try:
                d = json.loads(out)
                scheme = (d.get("style") or {}).get("scheme") or (d.get("appearance") or {}).get("scheme") or "auto"
                family = (d.get("meta") or {}).get("family") or "creed"
            except ValueError:
                pass
        # Window buttons where the OS puts them (traffic lights on the left on macOS).
        gs = Gtk.Settings.get_default()
        if gs is not None:
            gs.set_property("gtk-decoration-layout", "close,minimize,maximize:" if family == "macos" else ":minimize,maximize,close")
        sm = Adw.StyleManager.get_default()
        sm.set_color_scheme({"dark": Adw.ColorScheme.FORCE_DARK, "light": Adw.ColorScheme.FORCE_LIGHT}.get(scheme, Adw.ColorScheme.DEFAULT))

    def do_activate(self):
        self.follow_scheme()
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = self.props.active_window or Window(self, self.page, self.welcome)
        if self.page and isinstance(win, Window):
            win.stack.set_visible_child_name(self.page)
        win.present()


