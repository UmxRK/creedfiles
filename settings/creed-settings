class Window(Adw.ApplicationWindow):
    def __init__(self, app, start_page=None, welcome=False):
        super().__init__(application=app, title="Creed Settings", default_width=1000, default_height=700)
        self.store = Store(self)
        self.module_lists = {}
        self.toasts = Adw.ToastOverlay()
        act = Gio.SimpleAction.new("addmod", GLib.VariantType.new("s"))
        act.connect("activate", lambda _a, v: self.add_module(v.get_string()))
        self.add_action(act)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        pages = [
            ("modes", "Modes", "view-grid-symbolic", ModesPage(self)),
            ("appearance", "Appearance", "applications-graphics-symbolic", appearance_page(self.store, self)),
            ("glass", "Glass", "weather-fog-symbolic", glass_page(self.store)),
            ("bar", "Bar & Dock", "view-dual-symbolic", bar_page(self.store, self)),
            ("tweaks", "Tweaks", "applications-engineering-symbolic", TweaksPage(self)),
            ("game", "Game Mode", "input-gaming-symbolic", game_page(self.store)),
            ("desktop", "Desktop", "preferences-system-symbolic", system_page(self.store)),
            ("a11y", "Accessibility", "preferences-desktop-accessibility-symbolic", a11y_page(self.store)),
            ("about", "About", "help-about-symbolic", AboutPage(self)),
        ]
        for name, title, icon, widget in pages:
            pg = self.stack.add_titled(widget, name, title)
            pg.set_icon_name(icon)
        # Sidebar like Windows Settings / macOS System Settings: search field, then pages with icons.
        self.nav = Gtk.ListBox(css_classes=["navigation-sidebar"], vexpand=True)
        self.nav.set_size_request(230, -1)
        self.nav_rows = {}
        for name, title, icon, _w in pages:
            row = Gtk.ListBoxRow()
            row.page_name, row.page_title = name, title
            box = Gtk.Box(spacing=12, margin_top=6, margin_bottom=6, margin_start=6)
            box.append(Gtk.Image(icon_name=icon))
            box.append(Gtk.Label(label=title, xalign=0))
            row.set_child(box)
            row.update_property([Gtk.AccessibleProperty.LABEL], [title])
            self.nav.append(row)
            self.nav_rows[name] = row
        self.nav.connect("row-selected", lambda _l, r: r and self.stack.set_visible_child_name(r.page_name))
        self.stack.connect("notify::visible-child-name", lambda st, _p: self._sync_nav(st.get_visible_child_name()))
        search = Gtk.SearchEntry(placeholder_text="Find a setting", margin_start=8, margin_end=8, margin_top=4, margin_bottom=6)
        search.update_property([Gtk.AccessibleProperty.LABEL], ["Find a setting"])

        def on_search(entry):
            q = entry.get_text().strip().lower()
            self.nav.set_filter_func((lambda r: q in r.page_title.lower() or q in r.page_name) if q else None)
            if q:
                first = next((r for r in self.nav_rows.values() if q in r.page_title.lower() or q in r.page_name), None)
                if first:
                    self.nav.select_row(first)

        search.connect("search-changed", on_search)
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, vexpand=True)
        sidebar.append(search)
        sidebar.append(Gtk.ScrolledWindow(child=self.nav, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER))

        scope = Adw.SwitchRow(title="Only this mode", subtitle="Changes apply to the current mode only", use_markup=False)
        scope.connect("notify::active", lambda r, _p: setattr(self.store, "mode_only", r.get_active()))
        scope_box = Gtk.ListBox(css_classes=["boxed-list"], selection_mode=Gtk.SelectionMode.NONE, margin_start=8, margin_end=8, margin_bottom=8)
        scope_box.append(scope)

        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        side.append(sidebar)
        side.append(scope_box)
        split = Adw.NavigationSplitView()
        split.set_sidebar(Adw.NavigationPage(title="Creed", child=self._with_header(side, False)))
        # Big page title above the content (Windows Settings / System Settings style).
        self.page_title = Gtk.Label(xalign=0, css_classes=["title-1"], margin_start=24, margin_top=4, margin_bottom=8)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.append(self.page_title)
        content.append(self.stack)
        self.stack.set_vexpand(True)
        split.set_content(Adw.NavigationPage(title="Settings", child=self._with_header(content, True)))
        self.toasts.set_child(split)
        self.set_content(self.toasts)
        if welcome:
            self.toast("Welcome to Creed! Pick a mode to start - everything else can wait.")
            self.stack.set_visible_child_name("modes")
        elif start_page:
            self.stack.set_visible_child_name(start_page)
        self._sync_nav(self.stack.get_visible_child_name())

    def _sync_nav(self, name):
        row = self.nav_rows.get(name)
        if row is not None and hasattr(self, "page_title"):
            self.page_title.set_label(row.page_title)
        if row is not None and self.nav.get_selected_row() is not row:
            self.nav.select_row(row)

    def _with_header(self, child, content):
        tv = Adw.ToolbarView()
        tv.add_top_bar(Adw.HeaderBar(show_title=not content))
        tv.set_content(child)
        return tv

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text.strip()[:200]), timeout=4))

    def add_module(self, spec):
        key, m = spec.split("|", 1)
        if key in self.module_lists:
            self.module_lists[key].append(m)


