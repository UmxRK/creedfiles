#!/usr/bin/env python3
# Creed Settings - GTK4 / libadwaita front-end for `creed`.
# It never edits files itself: every change goes through `creed config set` (validated,
# atomic) so the settings app and hand-edited TOML can never disagree.
# Runs only while open; it costs nothing at idle.

import json
import os
import shutil
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

APP_ID = "org.creed.Settings"
CREED = shutil.which("creed") or os.path.expanduser("~/.local/bin/creed")

# Keys that change the Hyprland config (need `creed theme apply`), not just the shell.
HYPR_KEYS = ("glass.", "appearance.motion", "style.window", "style.titlebar", "style.material",
             "general.keybind_profile", "general.terminal", "general.file_manager", "general.browser",
             "general.kb_layout", "appearance.font", "appearance.scheme", "appearance.color_source",
             "appearance.preset", "appearance.wallpaper", "appearance.high_contrast", "a11y.reduce_motion")

BAR_MODULES = ["launcher", "workspaces", "window", "appmenu", "taskbar", "search", "taskview", "widgets",
               "clock", "date", "tray", "media", "network", "bluetooth", "volume", "battery", "sysstat",
               "weather", "keyboard", "gamemode", "notifications", "control", "power", "spacer"]

PROCEDURAL = [("creed://dawn", "Creed Dawn"), ("creed://dusk", "Creed Dusk"), ("creed://bloom", "Bloom"),
              ("creed://ribbon", "Ribbon"), ("creed://dunes", "Dunes"), ("creed://horizon", "Horizon"), ("creed://tahoe", "Tahoe"), ("creed://sequoia", "Sequoia"),
              ("creed://aurora", "Aurora"), ("creed://aqua", "Aqua")]

PRESETS = ["ember", "blossom", "dusk", "frost", "moss", "sand", "mono"]


def creed(*args, check=False):
    """Runs the creed CLI; returns (ok, stdout+stderr)."""
    try:
        p = subprocess.run([CREED, *args], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, str(e)
    out = (p.stdout + p.stderr).strip()
    if check and p.returncode != 0:
        raise RuntimeError(out)
    return p.returncode == 0, out


def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(round(v, 4)) if isinstance(v, float) else str(v)
    if isinstance(v, list):
        return "[" + ", ".join(json.dumps(x) for x in v) + "]"
    return json.dumps(v)


class Store:
    """Effective config (from `creed config dump`) plus debounced writes."""

    def __init__(self, window):
        self.window = window
        self.data = {}
        self.pending = {}
        self.timer = None
        self.mode_only = False
        self.reload()

    def reload(self):
        ok, out = creed("config", "dump")
        if ok:
            try:
                self.data = json.loads(out)
            except json.JSONDecodeError:
                self.data = {}
        else:
            self.window.toast(f"Config problem: {out}")

    def get(self, key, default=None):
        cur = self.data
        for part in key.split("."):
            if not isinstance(cur, dict) or part not in cur:
                return default
            cur = cur[part]
        return cur

    def set(self, key, value, immediate=False):
        # Mirror locally so dependent widgets see the change right away.
        cur = self.data
        parts = key.split(".")
        for p in parts[:-1]:
            cur = cur.setdefault(p, {})
        cur[parts[-1]] = value
        self.pending[key] = value
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add(10 if immediate else 450, self.flush)

    def flush(self):
        self.timer = None
        items, self.pending = self.pending, {}
        needs_theme = any(k.startswith(HYPR_KEYS) for k in items)
        mode_only = self.mode_only

        def work():
            errors = []
            for k, v in items.items():
                args = ["config", "set", k, toml_value(v)]
                if mode_only and not k.startswith("general.mode"):
                    args.append("--mode")
                ok, out = creed(*args)
                if not ok:
                    errors.append(out)
            if needs_theme and not errors:
                ok, out = creed("theme", "apply")
                if not ok:
                    errors.append(out)
            GLib.idle_add(self.done, errors)

        threading.Thread(target=work, daemon=True).start()
        return False

    def done(self, errors):
        if errors:
            self.window.toast(errors[0].replace("creed: ", ""))
            self.reload()
        return False


# ───────────────────────────── helpers to build rows ─────────────────────────────

def switch_row(store, key, title, subtitle=""):
    row = Adw.SwitchRow(title=title, subtitle=subtitle, use_markup=False)
    row.set_active(bool(store.get(key, False)))
    row.connect("notify::active", lambda r, _p: store.set(key, r.get_active()))
    return row


def spin_row(store, key, title, lo, hi, step, digits=0, subtitle=""):
    adj = Gtk.Adjustment(lower=lo, upper=hi, step_increment=step, page_increment=step * 5)
    row = Adw.SpinRow(title=title, subtitle=subtitle, adjustment=adj, digits=digits, use_markup=False)
    row.set_value(float(store.get(key, lo) or lo))
    row.connect("notify::value", lambda r, _p: store.set(key, round(r.get_value(), digits) if digits else int(r.get_value())))
    return row


def slider_row(store, key, title, lo, hi, step, subtitle="", fmt="{:.2f}"):
    row = Adw.ActionRow(title=title, subtitle=subtitle, use_markup=False)
    scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
    scale.set_hexpand(True)
    scale.set_size_request(220, -1)
    scale.set_draw_value(True)
    scale.set_value_pos(Gtk.PositionType.RIGHT)
    scale.set_format_value_func(lambda _s, v: fmt.format(v))
    scale.set_value(float(store.get(key, lo) or lo))
    scale.connect("value-changed", lambda s: store.set(key, round(s.get_value(), 3)))
    scale.update_property([Gtk.AccessibleProperty.LABEL], [title])
    row.add_suffix(scale)
    return row


def combo_row(store, key, title, options, subtitle=""):
    """options: list of (value, label)."""
    labels = Gtk.StringList.new([lbl for _, lbl in options])
    row = Adw.ComboRow(title=title, subtitle=subtitle, model=labels, use_markup=False)
    cur = store.get(key)
    values = [v for v, _ in options]
    if cur in values:
        row.set_selected(values.index(cur))
    row.connect("notify::selected", lambda r, _p: store.set(key, values[r.get_selected()]))
    return row


def entry_row(store, key, title):
    row = Adw.EntryRow(title=title, use_markup=False)
    row.set_text(str(store.get(key, "") or ""))
    row.set_show_apply_button(True)
    row.connect("apply", lambda r: store.set(key, r.get_text(), immediate=True))
    return row


def color_row(store, key, title, subtitle=""):
    row = Adw.ActionRow(title=title, subtitle=subtitle, use_markup=False)
    btn = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(with_alpha=True))
    rgba = Gdk.RGBA()
    rgba.parse(_css_color(store.get(key, "#ffffff10")))
    btn.set_rgba(rgba)
    btn.set_valign(Gtk.Align.CENTER)

    def changed(b, _p):
        c = b.get_rgba()
        hexv = "#{:02x}{:02x}{:02x}{:02x}".format(round(c.red * 255), round(c.green * 255), round(c.blue * 255), round(c.alpha * 255))
        store.set(key, hexv)

    btn.connect("notify::rgba", changed)
    row.add_suffix(btn)
    return row


def _css_color(hexv):
    h = (hexv or "#000000").lstrip("#")
    if len(h) == 8:
        r, g, b, a = (int(h[i:i + 2], 16) for i in (0, 2, 4, 6))
        return f"rgba({r},{g},{b},{a / 255:.3f})"
    return "#" + h


def esc(s):
    return GLib.markup_escape_text(s) if s else s


def group(title, description="", *rows):
    g = Adw.PreferencesGroup(title=esc(title), description=esc(description))
    for r in rows:
        g.add(r)
    return g


def page(title, icon, *groups):
    p = Adw.PreferencesPage(title=title, icon_name=icon)
    for g in groups:
        p.add(g)
    return p


