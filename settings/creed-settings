class AboutPage(Gtk.ScrolledWindow):
    def __init__(self, win):
        super().__init__(vexpand=True)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=24, margin_bottom=24, margin_start=24, margin_end=24)
        ok, ver = creed("version")
        box.append(Gtk.Label(label="Creed", xalign=0, css_classes=["title-1"]))
        box.append(Gtk.Label(label=ver, xalign=0, css_classes=["dim-label"]))
        self.ram = Gtk.Label(xalign=0, css_classes=["monospace"])
        self.doc = Gtk.Label(xalign=0, wrap=True, selectable=True, css_classes=["monospace"])
        for title, lbl in (("Memory", self.ram), ("Health check", self.doc)):
            box.append(Gtk.Label(label=title, xalign=0, css_classes=["heading"], margin_top=12))
            box.append(lbl)
        btns = Gtk.Box(spacing=8, margin_top=12)
        for label, args in (("Check again", None), ("Update Creed", ["update"])):
            b = Gtk.Button(label=label)
            b.connect("clicked", lambda _b, a=args: self.refresh(a))
            btns.append(b)
        box.append(btns)
        self.set_child(box)
        self.refresh(None)

    def refresh(self, args):
        def work():
            extra = creed(*args)[1] + "\n\n" if args else ""
            ram = creed("ram")[1]
            doc = creed("doctor")[1]
            GLib.idle_add(lambda: (self.ram.set_text(ram), self.doc.set_text(extra + doc)) and False)

        threading.Thread(target=work, daemon=True).start()


