#!/bin/bash
# creed-helper - the only program Creed runs as root (through pkexec + polkit).
# It accepts a tiny fixed vocabulary and only executes tweak scripts from the root-owned
# /usr/share/creed/tweaks tree. Nothing user-writable is ever executed as root.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
DATA=/usr/share/creed

die() { echo "creed-helper: $*" >&2; exit 2; }
[ "$(id -u)" -eq 0 ] || die "must run as root (via pkexec)"


case "${1:-}" in
  tweak)
    action=${2:-}; id=${3:-}; extra=${4:-}
    [[ "$action" =~ ^(apply|revert|status)$ ]] || die "bad action"
    [[ "$id" =~ ^[a-z0-9-]{1,40}$ ]] || die "bad tweak id"
    [[ -z "$extra" || "$extra" == "--confirm" ]] || die "bad flag"
    dir=$(find "$DATA/tweaks" -mindepth 2 -maxdepth 2 -type d -name "$id" | head -1)
    [ -n "$dir" ] || die "no such tweak"
    # Refuse anything not owned by root or writable by others.
    for f in "$DATA" "$DATA/tweaks" "$dir" "$dir"/*; do
      [ "$(stat -c %u "$f")" = 0 ] || die "$f is not owned by root"
      perms=$(stat -c %a "$f"); [[ "${perms: -1}" =~ [014] ]] || die "$f is writable by others"
    done
    user_home=$(getent passwd "${PKEXEC_UID:-0}" | cut -d: -f6)
    exec env -i PATH="$PATH" LANG=C.UTF-8 CREED_DATA="$DATA" CREED_USER_HOME="$user_home" \
      /usr/bin/creed tweak-root "$action" "$id" ${extra:+"$extra"}
    ;;
  sddm)
    mode=${2:-}
    [[ "$mode" =~ ^[a-z0-9-]{1,40}$ ]] || die "bad mode"
    case "$mode" in
      win*) theme=creed-windows ;;
      mac*) theme=creed-macos ;;
      *) theme=creed ;;
    esac
    [ -d "/usr/share/sddm/themes/$theme" ] || die "theme $theme not installed"
    mkdir -p /etc/sddm.conf.d
    printf '# Managed by Creed (login screen follows your mode)\n[Theme]\nCurrent=%s\n' "$theme" > /etc/sddm.conf.d/creed-theme.conf
    ;;
  *) die "usage: creed-helper tweak <apply|revert|status> <id> [--confirm] | sddm <mode>" ;;
esac
